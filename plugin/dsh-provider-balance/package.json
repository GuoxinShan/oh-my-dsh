{
  "name": "dsh-provider-balance",
  "version": "0.4.2",
  "description": "DSH web plugin: provider quota/balance badges — composer chip beside the context meter plus per-row badges on the Models settings page (GLM/Kimi/OpenCode/DeepSeek/Moonshot/xAI + Sub2API gateway auto-detect)",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aka-danielZhang/dsh-desktop.git",
    "directory": "plugin/dsh-provider-balance"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "provider",
    "quota"
  ],
  "files": [
    "src",
    "client",
    "cordis.yml",
    "cordis.bundle.yml",
    "README.md"
  ],
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./client/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.bundle.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
