{
  "name": "dsh-web-search-toggle",
  "version": "0.1.1",
  "description": "A General-settings toggle for the native web_search tool: shows whether the DeepSeek search credential is configured (the tool is model-independent) and disables the tool row through the home patch layer when the user searches via MCP instead",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./gateway": {
      "default": "./lib/gateway.js"
    },
    "./toggle-types": {
      "default": "./lib/toggle-types.js"
    },
    "./remote": {
      "default": "./lib/typert.remote-client.js"
    },
    "./typert.host": {
      "default": "./lib/typert.host.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsdown",
    "watch": "tsdown --watch",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "files": [
    "lib/*.js",
    "lib/client.js.map",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "web-search",
    "settings"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0-rc.7 <5",
    "@deepseek-ai/dsh-client-locale": ">=0.0.1-rc.1 <1",
    "@deepseek-ai/dsh-client-runtime": ">=0.0.1-rc.1 <1",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.0.1-rc.1 <1",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.0.1-rc.1 <1",
    "@deepseek-ai/dsh-credentials": ">=0.0.1-rc.1 <1",
    "@deepseek-ai/dsh-settings": ">=0.0.1-rc.1 <1",
    "@deepseek-ai/dsh-typert-protocol": ">=0.0.1-rc.1 <1",
    "@deepseek-ai/dsh-typert-registry": ">=0.0.1-rc.1 <1",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-client-locale": "0.1.0-rc.7",
    "@deepseek-ai/dsh-client-runtime": "0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.0-rc.7",
    "@deepseek-ai/dsh-credentials": "0.1.0-rc.7",
    "@deepseek-ai/dsh-settings": "0.1.0-rc.7",
    "@deepseek-ai/dsh-typert-protocol": "0.1.0-rc.7",
    "@deepseek-ai/dsh-typert-registry": "0.1.0-rc.7",
    "@types/node": "^24.13.3",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "tsdown": "^0.22.2",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3",
    "yaml": "^2.8.1",
    "zod": "^4.4.3",
    "lightningcss": "^1.30.2"
  },
  "packageManager": "pnpm@10.28.0"
}
