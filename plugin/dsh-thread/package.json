{
  "name": "dsh-thread",
  "version": "0.2.0-rc.2",
  "description": "Explicit cross-session Thread handoffs for DeepSeek Harness",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./tool": {
      "default": "./lib/tool.js"
    },
    "./gateway": {
      "default": "./lib/gateway.js"
    },
    "./draft": {
      "default": "./lib/draft.js"
    },
    "./identity": {
      "default": "./lib/identity.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-tool"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsdown",
    "watch": "tsdown --watch",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "files": [
    "lib/index.js",
    "lib/gateway.js",
    "lib/tool.js",
    "lib/draft.js",
    "lib/identity.js",
    "lib/thread-types.js",
    "lib/client.js",
    "lib/client.js.map",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "session",
    "handoff"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0-rc.7 <5",
    "@deepseek-ai/dsh-agent": ">=0.1.0-rc.8 <1",
    "@deepseek-ai/dsh-agent-presets": ">=0.1.0-rc.8 <1",
    "@deepseek-ai/dsh-client-connection": ">=0.1.0-rc.8 <1",
    "@deepseek-ai/dsh-client-runtime": ">=0.1.0-rc.8 <1",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.1.0-rc.8 <1",
    "@deepseek-ai/dsh-client-ui-layout": ">=0.1.0-rc.8 <1",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.1.0-rc.8 <1",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.1.0-rc.8 <1",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.0-rc.8 <1",
    "@deepseek-ai/dsh-client-ui-tool": ">=0.1.0-rc.8 <1",
    "@deepseek-ai/dsh-llm": ">=0.1.0-rc.8 <1",
    "@deepseek-ai/dsh-session": ">=0.1.0-rc.8 <1",
    "@deepseek-ai/dsh-session-title": ">=0.1.0-rc.8 <1",
    "@deepseek-ai/dsh-settings": ">=0.1.0-rc.8 <1",
    "@deepseek-ai/dsh-storage-domain": ">=0.1.0-rc.8 <1",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.8 <1",
    "@deepseek-ai/dsh-typert-protocol": ">=0.1.0-rc.8 <1",
    "@deepseek-ai/dsh-typert-registry": ">=0.1.0-rc.8 <1",
    "@deepseek-ai/dsh-workspace": ">=0.1.0-rc.8 <1",
    "@deepseek-ai/schemastery": ">=3.18.1 <4",
    "react": "^18.2.0"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.1-rc.2",
    "@deepseek-ai/dsh-agent-presets": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-connection": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-runtime": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-layout": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-tool": "0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session-title": "0.1.1-rc.2",
    "@deepseek-ai/dsh-settings": "0.1.1-rc.2",
    "@deepseek-ai/dsh-storage-domain": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.1.1-rc.2",
    "@deepseek-ai/dsh-typert-registry": "0.1.1-rc.2",
    "@deepseek-ai/dsh-workspace": "0.1.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.1",
    "@types/node": "^24.13.3",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "tsdown": "^0.22.2",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3",
    "@deepseek-ai/dsh-client-locale": "0.1.1-rc.2"
  },
  "packageManager": "pnpm@10.28.0"
}
